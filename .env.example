# --- Veritabanı (Faz 2) ---
# Taşınabilir Postgres 16 `.postgres/` altında çalışır: `npm run db:up`
DATABASE_URL="postgresql://finans:finans@127.0.0.1:5432/finans"

# --- Auth.js (Faz 2) ---
AUTH_SECRET=""

# --- Harici kaynaklar (Faz 2) ---
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
REDDIT_USER_AGENT="finans-program/0.1 by u/kullanici"

# Piyasa verisi (2F). Ücretsiz anahtar: https://finnhub.io/register
# Worker olmadan piyasa kartları boş kalır; sayfa kendi çekim yapmaz.
FINNHUB_API_KEY=""

# YOUTUBE_API_KEY kaldırıldı: 2D'de günün videosu ders kaynaklarından besleniyor,
# Data API entegrasyonu gereksiz kapsam olarak kapatıldı.

# Faz 1 bu değişkenlerin hiçbirini okumaz — dashboard tamamen src/mocks üzerinden çalışır.
